{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "outDir": "dist-electron",
    "rootDir": ".",
    "types": ["node"],
    "esModuleInterop": true
  },
  "include": ["electron/**/*.ts", "src/shared/**/*.ts"]
}
